# Served by DreamHost (Apache). Every block is guarded so a missing module cannot cause a 500 error.

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  # The page, the service worker and the manifest must always be rechecked, so updates arrive.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Built files have a hash in their name and never change.
  <FilesMatch "\.(js|css|woff2?|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # sw.js is allowed to control the whole subdomain.
  <Files "sw.js">
    Header set Service-Worker-Allowed "/"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/manifest+json
</IfModule>
