{
  "name": "pizza-dough-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tokens": "node scripts/build-tokens.mjs",
    "predev": "npm run tokens",
    "prebuild": "npm run tokens",
    "build": "vite build && node scripts/check-budget.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit && node scripts/check-style.mjs",
