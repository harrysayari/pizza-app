{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pdp-saved-state-v1",
  "title": "Saved state, key pdp:v1",
  "description": "Everything the app remembers on the device. Instants are ISO 8601 strings with a timezone offset or Z. Unknown fields MUST be ignored; a missing or invalid object MUST be treated as empty (FR-039).",
  "type": "object",
  "required": ["version", "preferences"],
  "additionalProperties": true,
  "properties": {
    "version": { "const": 1 },
    "savedAt": { "type": "string", "format": "date-time" },
    "request": {
      "type": "object",
      "required": ["size", "pizzas", "day", "time"],
      "properties": {
        "size": { "enum": [12, 14, 16] },
        "pizzas": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "time": { "enum": ["lunch", "early", "dinner"] }
      }
    },
    "bakeAt": { "type": "string", "format": "date-time" },
    "fridgeMinutes": { "type": "integer", "minimum": 960, "maximum": 1440 },
    "ticked": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ingredient ids the user has ticked."
    },
    "doneAt": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "date-time" },
      "description": "Step id to the instant the user tapped Done."
    },
    "timer": {
      "type": ["object", "null"],
      "required": ["stepId", "state"],
      "properties": {
        "stepId": { "type": "string" },
        "state": { "enum": ["idle", "running", "paused", "finished"] },
        "endAt": { "type": "string", "format": "date-time" },
        "remainingMs": { "type": "integer", "minimum": 0 },
        "alerted": { "type": "boolean" }
      }
    },
    "preferences": {
      "type": "object",
      "required": ["muted", "keepScreenOn", "theme"],
      "properties": {
        "muted": { "type": "boolean", "default": false },
        "keepScreenOn": { "type": "boolean", "default": true },
        "theme": { "enum": ["system", "light", "dark"], "default": "system" }
      }
    },
    "progress": {
      "type": "object",
      "properties": {
        "screen": { "enum": ["plan", "schedule", "steps"] },
        "currentStepId": { "type": ["string", "null"] }
      }
    }
  }
}
