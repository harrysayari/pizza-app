# Copy this file to .env.deploy and fill it in. .env.deploy is git-ignored: never commit it.
# Used by: npm run deploy

# The SFTP server name from the DreamHost panel (Users > the SFTP user).
SFTP_HOST=
SFTP_USER=
SFTP_PORT=22

# The folder the app is uploaded into, relative to where SFTP lands you. The app is served at
# https://designandinspire.com.au/pizza/, so index.html must end up directly inside that folder.
# On a DreamPress (WordPress) account SFTP lands in the WordPress folder (wp-content is in it), so this is "pizza".
# On a regular DreamHost account it is the site folder plus /pizza, for example designandinspire.com.au/pizza.
SFTP_REMOTE_DIR=pizza

# How to log in. Pick one:
#  1. An SSH key (best). Leave the password out.
SFTP_KEY_FILE=
#  2. Nothing here: you are asked for the password each time you deploy.
#  3. A stored password, read from this file. It is never printed or put on a command line.
SFTP_PASSWORD=

# After an upload, the live site is checked at this address (optional).
SITE_URL=https://designandinspire.com.au/pizza
