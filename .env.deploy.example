# Copy this file to .env.deploy and fill it in. .env.deploy is git-ignored: never commit it.
# Used by: npm run deploy

# The SFTP server name from the DreamHost panel (Users > the SFTP user).
SFTP_HOST=
SFTP_USER=
SFTP_PORT=22

# The site's folder in the user's home, for example the folder DreamHost made for the subdomain.
# index.html ends up directly inside it.
SFTP_REMOTE_DIR=pizza.ccc.com.au

# How to log in. Pick one:
#  1. An SSH key (best). Leave the password out.
SFTP_KEY_FILE=
#  2. Nothing here: you are asked for the password each time you deploy.
#  3. A stored password. Needs the "sshpass" tool installed (macOS: brew install hudochenkov/sshpass/sshpass).
SFTP_PASSWORD=

# After an upload, the live site is checked at this address (optional).
SITE_URL=https://pizza.ccc.com.au
